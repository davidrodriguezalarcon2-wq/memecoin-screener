# Copia este archivo a ".env" y rellena tus valores reales.
# El .env NO se sube a git (está en .gitignore). En Railway, estos van como variables
# de entorno en el panel del servicio, NO en un archivo.
#
# Para correr en local con estas variables:  node --env-file=.env screener.js

# --- Telegram (alertas) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook alternativo (n8n -> WhatsApp / Discord). Deja vacío si usas Telegram ---
ALERT_WEBHOOK_URL=

# --- Supabase (tracking + backtest) ---
SUPABASE_URL=https://TUPROYECTO.supabase.co
SUPABASE_SERVICE_KEY=
